<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#075e9f">
  <meta name="description" content="Create your private Santorini memory album on this device.">
  <title>Santorini Memories</title>

  <style>
    :root {
      --blue: #075e9f;
      --deep-blue: #063b68;
      --sky: #dff5ff;
      --white: #ffffff;
      --sand: #fff8ed;
      --gold: #f2bb66;
      --text: #17324a;
      --muted: #687d8e;
      --danger: #b42318;
      --shadow: 0 18px 55px rgba(6, 59, 104, 0.16);
      --radius: 26px;
      --safe-bottom: env(safe-area-inset-bottom, 0px);
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
      background: var(--sand);
    }

    body {
      margin: 0;
      min-height: 100vh;
      color: var(--text);
      background:
        radial-gradient(circle at 10% 0%, rgba(88, 190, 235, 0.24), transparent 28rem),
        radial-gradient(circle at 95% 15%, rgba(242, 187, 102, 0.23), transparent 25rem),
        linear-gradient(180deg, #f4fbff 0%, #fff9ef 100%);
      font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    button,
    input,
    label {
      font: inherit;
    }

    button,
    .upload-button {
      -webkit-tap-highlight-color: transparent;
    }

    .page {
      width: min(100% - 28px, 760px);
      margin: 0 auto;
      padding: 28px 0 calc(42px + var(--safe-bottom));
    }

    .hero {
      position: relative;
      overflow: hidden;
      padding: 46px 26px;
      border-radius: 32px;
      color: #fff;
      text-align: center;
      background:
        radial-gradient(circle at 85% 0%, rgba(255, 222, 165, 0.38), transparent 19rem),
        linear-gradient(145deg, var(--deep-blue), var(--blue) 64%, #24a1d6);
      box-shadow: var(--shadow);
    }

    .hero::after {
      content: "";
      position: absolute;
      left: -10%;
      right: -10%;
      bottom: -58px;
      height: 110px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.1);
      transform: rotate(-3deg);
    }

    .kicker {
      margin: 0 0 10px;
      font-size: 0.78rem;
      font-weight: 900;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      opacity: 0.84;
    }

    h1 {
      position: relative;
      z-index: 1;
      margin: 0;
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(2.7rem, 12vw, 5rem);
      font-weight: 500;
      line-height: 0.95;
      letter-spacing: -0.05em;
    }

    .hero p:last-child {
      position: relative;
      z-index: 1;
      max-width: 560px;
      margin: 18px auto 0;
      color: rgba(255, 255, 255, 0.9);
      font-size: 1rem;
    }

    .card {
      margin-top: 22px;
      padding: 24px;
      border: 1px solid rgba(7, 94, 159, 0.12);
      border-radius: var(--radius);
      background: rgba(255, 255, 255, 0.9);
      box-shadow: var(--shadow);
      backdrop-filter: blur(14px);
    }

    .privacy-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 15px;
      padding: 8px 12px;
      border-radius: 999px;
      color: var(--deep-blue);
      background: var(--sky);
      font-size: 0.8rem;
      font-weight: 900;
    }

    .privacy-badge svg {
      width: 17px;
      height: 17px;
    }

    h2 {
      margin: 0 0 10px;
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(1.9rem, 7vw, 3rem);
      font-weight: 500;
      line-height: 1.04;
      letter-spacing: -0.035em;
    }

    .intro {
      margin: 0 0 20px;
      color: var(--muted);
    }

    .upload-button {
      min-height: 58px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 14px 20px;
      border-radius: 999px;
      color: #fff;
      background: linear-gradient(135deg, var(--blue), #168cc7);
      box-shadow: 0 13px 30px rgba(7, 94, 159, 0.24);
      font-weight: 900;
      cursor: pointer;
      transition: transform 180ms ease, box-shadow 180ms ease;
    }

    .upload-button:hover {
      transform: translateY(-2px);
      box-shadow: 0 16px 34px rgba(7, 94, 159, 0.28);
    }

    .upload-button svg {
      width: 22px;
      height: 22px;
    }

    #photoInput {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
      clip-path: inset(50%);
    }

    .counter {
      margin: 13px 0 0;
      color: var(--muted);
      font-size: 0.88rem;
      text-align: center;
    }

    .message {
      display: none;
      margin-top: 15px;
      padding: 12px 14px;
      border-radius: 14px;
      color: var(--deep-blue);
      background: #e9f7ff;
      text-align: center;
      font-size: 0.9rem;
      font-weight: 750;
    }

    .message.show {
      display: block;
    }

    .gallery-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin: 28px 0 15px;
    }

    .gallery-header h3 {
      margin: 0;
      font-size: 1.05rem;
    }

    .clear-button {
      min-height: 42px;
      padding: 9px 13px;
      border: 1px solid rgba(180, 35, 24, 0.19);
      border-radius: 999px;
      color: var(--danger);
      background: #fff7f6;
      font-weight: 850;
      cursor: pointer;
    }

    .clear-button[hidden] {
      display: none;
    }

    .gallery {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .photo-card {
      position: relative;
      overflow: hidden;
      min-height: 190px;
      border-radius: 20px;
      background: #d9edf6;
      box-shadow: 0 12px 30px rgba(6, 59, 104, 0.13);
    }

    .photo-card img {
      width: 100%;
      height: 100%;
      min-height: 190px;
      display: block;
      object-fit: cover;
    }

    .delete-button {
      position: absolute;
      top: 9px;
      right: 9px;
      width: 42px;
      height: 42px;
      display: grid;
      place-items: center;
      border: 0;
      border-radius: 50%;
      color: #fff;
      background: rgba(16, 27, 38, 0.78);
      box-shadow: 0 7px 18px rgba(0, 0, 0, 0.2);
      cursor: pointer;
      backdrop-filter: blur(8px);
    }

    .delete-button svg {
      width: 19px;
      height: 19px;
    }

    .empty {
      padding: 38px 18px;
      border: 2px dashed rgba(7, 94, 159, 0.18);
      border-radius: 20px;
      color: var(--muted);
      text-align: center;
      background: rgba(237, 249, 255, 0.55);
    }

    .empty svg {
      width: 45px;
      height: 45px;
      margin-bottom: 9px;
      color: var(--blue);
    }

    .note {
      margin: 18px 0 0;
      padding: 15px;
      border-radius: 16px;
      color: #5f4a1f;
      background: #fff6de;
      font-size: 0.86rem;
      line-height: 1.5;
    }

    footer {
      padding: 24px 10px 0;
      color: #728493;
      text-align: center;
      font-size: 0.8rem;
    }

    footer a {
      color: var(--blue);
      font-weight: 850;
      text-decoration: none;
    }

    @media (min-width: 620px) {
      .gallery {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    @media (max-width: 390px) {
      .gallery {
        grid-template-columns: 1fr;
      }

      .photo-card,
      .photo-card img {
        min-height: 245px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      * {
        scroll-behavior: auto !important;
        transition: none !important;
      }
    }
  </style>
</head>

<body>
  <main class="page">
    <section class="hero">
      <p class="kicker">Private memory album</p>
      <h1>Santorini Memories</h1>
      <p>Your photos stay only on this device and in this browser.</p>
    </section>

    <section class="card">
      <div class="privacy-badge">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <rect x="5" y="10" width="14" height="10" rx="2" stroke="currentColor" stroke-width="2"/>
          <path d="M8 10V7a4 4 0 1 1 8 0v3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
        Stored only on your phone
      </div>

      <h2>Add your Santorini memories</h2>
      <p class="intro">
        Choose up to 6 photos. They will appear here every time you open this page
        from the same phone and browser.
      </p>

      <label class="upload-button" for="photoInput">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M12 16V4m0 0L7.5 8.5M12 4l4.5 4.5M5 14v4a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Add your photos
      </label>

      <input
        id="photoInput"
        type="file"
        accept="image/*"
        multiple
        aria-label="Choose photos"
      >

      <p id="counter" class="counter">0 of 6 photos saved</p>
      <div id="message" class="message" role="status" aria-live="polite"></div>

      <div class="gallery-header">
        <h3>Your memories</h3>
        <button id="clearButton" class="clear-button" type="button" hidden>
          Delete all
        </button>
      </div>

      <div id="gallery" class="gallery" aria-live="polite"></div>

      <p class="note">
        Important: these photos are not uploaded to GitHub or to another server.
        They disappear if the browser data is cleared, the page URL changes,
        or you use another phone or browser.
      </p>
    </section>

    <footer>
      <div>Powered by Jewel Art</div>
      <div>
        Instagram:
        <a href="https://www.instagram.com/lazaros_jewelart/">
          Lazaros Jewel Art
        </a>
      </div>
    </footer>
  </main>

  <script>
    const DB_NAME = "santorini-memories-db";
    const DB_VERSION = 1;
    const STORE_NAME = "photos";
    const MAX_PHOTOS = 6;
    const MAX_IMAGE_SIDE = 1600;
    const JPEG_QUALITY = 0.82;

    const photoInput = document.getElementById("photoInput");
    const gallery = document.getElementById("gallery");
    const counter = document.getElementById("counter");
    const message = document.getElementById("message");
    const clearButton = document.getElementById("clearButton");

    let db;
    let currentPhotos = [];
    let objectUrls = [];

    function openDatabase() {
      return new Promise((resolve, reject) => {
        const request = indexedDB.open(DB_NAME, DB_VERSION);

        request.onupgradeneeded = () => {
          const database = request.result;

          if (!database.objectStoreNames.contains(STORE_NAME)) {
            const store = database.createObjectStore(STORE_NAME, {
              keyPath: "id"
            });
            store.createIndex("createdAt", "createdAt");
          }
        };

        request.onsuccess = () => resolve(request.result);
        request.onerror = () => reject(request.error);
      });
    }

    function createTransaction(mode = "readonly") {
      return db.transaction(STORE_NAME, mode).objectStore(STORE_NAME);
    }

    function getAllPhotos() {
      return new Promise((resolve, reject) => {
        const request = createTransaction().getAll();

        request.onsuccess = () => {
          const photos = request.result.sort(
            (a, b) => a.createdAt - b.createdAt
          );
          resolve(photos);
        };

        request.onerror = () => reject(request.error);
      });
    }

    function savePhoto(photo) {
      return new Promise((resolve, reject) => {
        const request = createTransaction("readwrite").put(photo);
        request.onsuccess = () => resolve();
        request.onerror = () => reject(request.error);
      });
    }

    function removePhoto(id) {
      return new Promise((resolve, reject) => {
        const request = createTransaction("readwrite").delete(id);
        request.onsuccess = () => resolve();
        request.onerror = () => reject(request.error);
      });
    }

    function clearPhotos() {
      return new Promise((resolve, reject) => {
        const request = createTransaction("readwrite").clear();
        request.onsuccess = () => resolve();
        request.onerror = () => reject(request.error);
      });
    }

    function makeId() {
      if (crypto.randomUUID) return crypto.randomUUID();

      return (
        Date.now().toString(36) +
        Math.random().toString(36).slice(2)
      );
    }

    function showMessage(text) {
      message.textContent = text;
      message.classList.add("show");

      clearTimeout(showMessage.timer);
      showMessage.timer = setTimeout(() => {
        message.classList.remove("show");
      }, 3200);
    }

    function releaseObjectUrls() {
      objectUrls.forEach((url) => URL.revokeObjectURL(url));
      objectUrls = [];
    }

    function emptyGalleryMarkup() {
      return `
        <div class="empty" style="grid-column:1/-1">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="3" y="4" width="18" height="16" rx="3" stroke="currentColor" stroke-width="1.8"/>
            <circle cx="9" cy="10" r="2" stroke="currentColor" stroke-width="1.8"/>
            <path d="m5.5 17 4.3-4.3a1.5 1.5 0 0 1 2.1 0l1.7 1.7 1.2-1.2a1.5 1.5 0 0 1 2.1 0l1.6 1.6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <div>No photos added yet.</div>
        </div>
      `;
    }

    function renderGallery() {
      releaseObjectUrls();

      counter.textContent =
        `${currentPhotos.length} of ${MAX_PHOTOS} photos saved`;

      clearButton.hidden = currentPhotos.length === 0;

      if (currentPhotos.length === 0) {
        gallery.innerHTML = emptyGalleryMarkup();
        return;
      }

      gallery.innerHTML = "";

      currentPhotos.forEach((photo) => {
        const url = URL.createObjectURL(photo.blob);
        objectUrls.push(url);

        const card = document.createElement("article");
        card.className = "photo-card";

        const image = document.createElement("img");
        image.src = url;
        image.alt = "Your Santorini memory";
        image.loading = "lazy";

        const deleteButton = document.createElement("button");
        deleteButton.className = "delete-button";
        deleteButton.type = "button";
        deleteButton.setAttribute("aria-label", "Delete this photo");
        deleteButton.innerHTML = `
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M4 7h16M9 7V4h6v3m-8 0 1 13h8l1-13M10 11v5M14 11v5" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        `;

        deleteButton.addEventListener("click", async () => {
          try {
            await removePhoto(photo.id);
            await refreshGallery();
            showMessage("Photo deleted.");
          } catch (error) {
            console.error(error);
            showMessage("The photo could not be deleted.");
          }
        });

        card.append(image, deleteButton);
        gallery.append(card);
      });
    }

    async function refreshGallery() {
      currentPhotos = await getAllPhotos();
      renderGallery();
    }

    function loadImage(file) {
      return new Promise((resolve, reject) => {
        const url = URL.createObjectURL(file);
        const image = new Image();

        image.onload = () => {
          URL.revokeObjectURL(url);
          resolve(image);
        };

        image.onerror = () => {
          URL.revokeObjectURL(url);
          reject(new Error("Invalid image file."));
        };

        image.src = url;
      });
    }

    async function compressImage(file) {
      const image = await loadImage(file);

      let width = image.naturalWidth;
      let height = image.naturalHeight;

      if (width > MAX_IMAGE_SIDE || height > MAX_IMAGE_SIDE) {
        const scale = Math.min(
          MAX_IMAGE_SIDE / width,
          MAX_IMAGE_SIDE / height
        );

        width = Math.round(width * scale);
        height = Math.round(height * scale);
      }

      const canvas = document.createElement("canvas");
      canvas.width = width;
      canvas.height = height;

      const context = canvas.getContext("2d", { alpha: false });
      context.fillStyle = "#ffffff";
      context.fillRect(0, 0, width, height);
      context.drawImage(image, 0, 0, width, height);

      return new Promise((resolve, reject) => {
        canvas.toBlob(
          (blob) => {
            if (blob) {
              resolve(blob);
            } else {
              reject(new Error("Image compression failed."));
            }
          },
          "image/jpeg",
          JPEG_QUALITY
        );
      });
    }

    photoInput.addEventListener("change", async () => {
      const selectedFiles = [...photoInput.files].filter((file) =>
        file.type.startsWith("image/")
      );

      photoInput.value = "";

      if (selectedFiles.length === 0) return;

      const remainingSlots = MAX_PHOTOS - currentPhotos.length;

      if (remainingSlots <= 0) {
        showMessage(`You can save up to ${MAX_PHOTOS} photos.`);
        return;
      }

      const filesToSave = selectedFiles.slice(0, remainingSlots);

      if (selectedFiles.length > remainingSlots) {
        showMessage(
          `Only ${remainingSlots} more photo${remainingSlots === 1 ? "" : "s"} can be added.`
        );
      } else {
        showMessage("Preparing your photos…");
      }

      try {
        for (const file of filesToSave) {
          const blob = await compressImage(file);

          await savePhoto({
            id: makeId(),
            createdAt: Date.now() + Math.random(),
            name: file.name,
            blob
          });
        }

        await refreshGallery();
        showMessage("Your photos were saved on this device.");
      } catch (error) {
        console.error(error);
        showMessage(
          "A photo could not be saved. Try a smaller image or remove an older photo."
        );
      }
    });

    clearButton.addEventListener("click", async () => {
      const confirmed = confirm(
        "Delete all photos stored on this device?"
      );

      if (!confirmed) return;

      try {
        await clearPhotos();
        await refreshGallery();
        showMessage("All photos were deleted.");
      } catch (error) {
        console.error(error);
        showMessage("The photos could not be deleted.");
      }
    });

    window.addEventListener("beforeunload", releaseObjectUrls);

    async function start() {
      try {
        db = await openDatabase();
        await refreshGallery();
      } catch (error) {
        console.error(error);
        gallery.innerHTML = `
          <div class="empty" style="grid-column:1/-1">
            Local photo storage is not available in this browser.
          </div>
        `;
        showMessage("Local storage could not be opened.");
      }
    }

    start();
  </script>
</body>
</html>
